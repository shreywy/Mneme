# Copy to .env.local for local development. Both values are public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: an Imgur API client id (free at https://api.imgur.com/oauth2/addclient, "anonymous usage").
# Without it, pictures on pages stay in the browser they were added in.
VITE_IMGUR_CLIENT_ID=
